# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# DO NOT EXPOSE THIS. Required for any server route that reads or writes
# data across users (matches, dashboard, contact info, account deletion).
# RLS restricts the regular client to a user's own row;
# Service role bypasses RLS and must remain server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
